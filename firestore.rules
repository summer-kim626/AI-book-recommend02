rules_version = '2';

// 마음 서가 Firestore 보안 규칙
// 적용 위치: Firebase 프로젝트 maeum-seoga → Firestore Database (default) → 규칙
// 이 파일을 고치면 콘솔의 규칙 탭에 그대로 붙여넣고 게시한다.
service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자: Google 로그인 + 이메일 인증 + 허용된 계정. site-config.js의 adminEmails와 같아야 한다.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['seungyeop2002@gmail.com'];
    }

    // 관리자 설정 문서: 메인 페이지 방문자는 누구나 읽고, 관리자만 저장한다.
    match /config/public {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['apiKey', 'model', 'guidelines', 'updatedAt', 'updatedBy'])
        && request.resource.data.apiKey is string && request.resource.data.apiKey.size() < 200
        && request.resource.data.model is string && request.resource.data.model.size() < 100
        && request.resource.data.guidelines is string && request.resource.data.guidelines.size() < 20000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if false;
    }

    // 그 밖의 모든 문서는 막는다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
