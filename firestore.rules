rules_version = '2';

// 마음 서가 관리자 설정 규칙
// Firebase 콘솔 → Firestore Database → 규칙(Rules)에 붙여넣고 게시(Publish)한다.
// 이미 다른 컬렉션 규칙이 있다면 match /config/public 블록만 합친다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /config/public {
      // 메인 페이지 방문자는 누구나 설정을 읽는다 (API 키 포함 — 키에 웹사이트 제한을 걸어 둘 것)
      allow read: if true;

      // 관리자 구글 계정만 저장할 수 있다. site-config.js의 adminEmails와 같아야 한다.
      allow write: if request.auth != null
        && request.auth.token.email == "seungyeop2002@gmail.com"
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(["apiKey", "model", "guidelines", "updatedAt", "updatedBy"])
        && request.resource.data.guidelines is string
        && request.resource.data.guidelines.size() < 20000;
    }
  }
}
